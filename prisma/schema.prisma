/// Durable verification account for the fundraising KYC flow. Replaces the
/// previous process-memory-only `FundraisingStore` account map — one row
/// per owner (`ownerUserId` unique), holding identity/location/status data
/// that must survive restarts, deploys, and multiple API instances.
/// `mediaId`/`ownerUserId` are deliberately plain scalar columns (no Prisma
/// relation to `User`/`Media`) so this migration does not touch those
/// unrelated models — existence/ownership is still enforced at the service
/// layer exactly as it was for the in-memory store.
model FundraisingVerificationAccount {
  id                    Int                               @id @default(autoincrement())
  ownerUserId           Int                               @unique
  status                FundraisingVerificationStatus     @default(DRAFT)
  accountType           String?                           @db.VarChar(32)
  fullName              String?
  /// Encrypted at rest (AES-256-GCM, see kyc-encryption.ts) as a
  /// `v<version>:<iv>:<authTag>:<ciphertext>` envelope. Canonical plaintext
  /// is a date-only value (YYYY-MM-DD) — never a DateTime, so no UTC
  /// conversion can shift the stored calendar day. No longer fixed-width
  /// (VarChar(10)) since the envelope is much longer than the plaintext.
  dateOfBirth           String?
  /// Encrypted at rest — see kyc-encryption.ts.
  presentAddress        String?
  /// Encrypted at rest — see kyc-encryption.ts.
  permanentAddress      String?
  occupation            String?
  isInternational       Boolean                           @default(false)
  divisionId            Int?
  districtId            Int?
  upazilaId             Int?
  unionId               Int?
  areaId                Int?
  area                  String?
  countryCode           String?                           @db.VarChar(8)
  countryName           String?
  stateName             String?
  cityName              String?
  /// Encrypted at rest — see kyc-encryption.ts.
  addressLine           String?
  latitude              Decimal?                          @db.Decimal(10, 8)
  longitude             Decimal?                          @db.Decimal(11, 8)
  formattedAddress      String?
  primaryDocumentType   String?
  /// Private identity fields, encrypted at rest (AES-256-GCM envelope —
  /// see kyc-encryption.ts) — never log, never serialize into any public
  /// campaign DTO. Only the owner and an authorized reviewer/admin may read
  /// these (enforced in `fundraising-store.ts`, not only route middleware).
  nationalIdNumber      String?
  birthRegNumber        String?
  passportNumber        String?
  studentIdNumber       String?
  drivingLicenceNumber  String?
  verificationDraftJson Json?
  /// Reviewer-facing rejection note — owner/admin only, never public.
  rejectionReason       String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedByUserId      Int?
  /// Optimistic-concurrency token — every update must match the version it
  /// read and increments it; a stale write fails instead of silently
  /// clobbering a concurrent change.
  version               Int                               @default(0)
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  documents             FundraisingVerificationDocument[]

  @@index([status])
  @@index([status, submittedAt])
  @@map("fundraising_verification_accounts")
}

/// Binds an uploaded `Media` row (existing media system) to a verification
/// account as either the required PRIMARY identity document or an optional
/// SUPPORTING one. Soft-deleted via `deletedAt` so removal history is kept
/// for reviewers without a hard delete.
model FundraisingVerificationDocument {
  id           Int                                 @id @default(autoincrement())
  accountId    Int
  mediaId      Int
  title        String
  documentType FundraisingVerificationDocumentType @default(SUPPORTING)
  createdAt    DateTime                            @default(now())
  deletedAt    DateTime?
  account      FundraisingVerificationAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, deletedAt])
  @@index([mediaId])
  @@map("fundraising_verification_documents")
}

