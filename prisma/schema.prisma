generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                              Int                     @id @default(autoincrement())
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  friendRequestsSent              FriendRequest[]         @relation("FriendRequestSender")
  friendRequestsReceived          FriendRequest[]         @relation("FriendRequestRecipient")
  uploadedMedia                   Media[]                 @relation("MediaOwner")
  authoredPosts                   Post[]                  @relation("PostAuthor")
  postBookmarks                   PostBookmark[]          @relation("PostBookmarkedBy")
  authoredComments                PostComment[]           @relation("CommentAuthor")
  commentLikes                    PostCommentLike[]       @relation("CommentLikedBy")
  postLikes                       PostLike[]              @relation("PostLikedBy")
  postShares                      PostShare[]             @relation("PostSharedBy")
  postViews                       PostView[]              @relation("PostViewedBy")
  blocksReceived                  UserBlock[]             @relation("UserBlocked")
  blocksGiven                     UserBlock[]             @relation("UserBlocker")
  centralAuthLink                 UserCentralAuthLink?
  following                       UserFollow[]            @relation("UserFollowing")
  followers                       UserFollow[]            @relation("UserFollowers")
  profile                         UserProfile?
  profileLikesGiven               UserProfileLike[]       @relation("ProfileLikeActor")
  profileLikesReceived            UserProfileLike[]       @relation("ProfileLikeTarget")
  wallet                          Wallet?
  walletLedgerEntries             WalletLedgerEntry[]
  walletWithdrawRequests          WalletWithdrawRequest[]
  adoptionApplicationsAsApplicant AdoptionApplication[]   @relation("AdoptionApplicationApplicant")
  adoptionApplicationsAsOwner     AdoptionApplication[]   @relation("AdoptionApplicationOwner")
  adoptionListings                AdoptionListing[]
}

model UserCentralAuthLink {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  subject    String   @unique
  linkedAt   DateTime @default(now())
  linkMethod String   @default("direct")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subject])
}

model UserAuth {
  id              Int       @id @default(autoincrement())
  userId          Int
  email           String?   @unique
  phone           String?
  provider        String    @default("LOCAL")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([email])
  @@index([phone])
}

model Wallet {
  userId  Int     @id
  points  Int     @default(0)
  balance Decimal @db.Decimal(18, 2)
  tier    String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletLedgerEntry {
  id             Int       @id @default(autoincrement())
  userId         Int
  kind           String
  status         String
  amountMinor    BigInt
  currencyCode   String    @default("BDT")
  sourceType     String?
  sourceId       Int?
  note           String?
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  postedAt       DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("wallet_ledger_entries")
}

model WalletWithdrawRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  amountMinor    BigInt
  currencyCode   String    @default("BDT")
  method         String
  payoutDetails  Json
  note           String?
  status         String
  failureReason  String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reviewedAt     DateTime?
  processedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@map("wallet_withdraw_requests")
}

model UserProfile {
  userId          Int               @id
  username        String            @unique
  displayName     String
  bio             String?
  visibility      ProfileVisibility @default(PUBLIC)
  showEmail       Boolean           @default(true)
  showPhone       Boolean           @default(false)
  avatarMediaId   Int?
  coverMediaId    Int?
  education       String?
  placeLive       String?
  fansAndFriends  String?
  from            String?
  profileType     String?
  workStatus      String?
  religiousStatus String?
  gender          String?
  birthdate       DateTime?
  maritalStatus   String?
  isLocked        Boolean           @default(false)
  avatarMedia     Media?            @relation("UserProfileAvatar", fields: [avatarMediaId], references: [id])
  coverMedia      Media?            @relation("UserProfileCover", fields: [coverMediaId], references: [id])
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility])
  @@index([displayName])
}

model Media {
  id                   Int           @id @default(autoincrement())
  ownerUserId          Int
  filename             String
  mimetype             String
  size                 Int
  storageKey           String        @unique
  url                  String        @unique
  thumbnailUrl         String?
  hlsUrl               String?
  status               MediaStatus   @default(READY)
  processingError      String?
  purpose              String        @default("generic")
  contentType          String?
  contentId            String?
  uploadIdempotencyKey String?
  createdAt            DateTime      @default(now())
  deletionRetries      Int           @default(0)
  markedForDeletionAt  DateTime?
  ownerUser            User          @relation("MediaOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  commentAttachments   PostComment[] @relation("CommentAttachment")
  postMedia            PostMedia[]   @relation("PostMediaAsset")
  avatarProfiles       UserProfile[] @relation("UserProfileAvatar")
  coverProfiles        UserProfile[] @relation("UserProfileCover")

  @@unique([ownerUserId, uploadIdempotencyKey])
  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@index([markedForDeletionAt])
  @@index([contentType, contentId])
}

model Post {
  id                    Int            @id @default(autoincrement())
  authorId              Int
  type                  PostType       @default(TEXT)
  category              PostCategory   @default(GENERAL)
  caption               String?
  context               String?
  privacy               PostPrivacy    @default(PUBLIC)
  backgroundStyle       String?
  postType              String?
  lostPetName           String?
  lostPetLocation       String?
  lostPetContactVisible Boolean        @default(false)
  locationTag           String?
  feelingId             String?
  feelingLabel          String?
  feelingEmoji          String?
  activityId            String?
  activityLabel         String?
  activityEmoji         String?
  songTitle             String?
  songArtist            String?
  songStartMs           Int?
  songDurationMs        Int?
  fundraisingCampaignId Int?
  shareCount            Int            @default(0)
  viewCount             Int            @default(0)
  status                PostStatus     @default(ACTIVE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  author                User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  bookmarks             PostBookmark[]
  comments              PostComment[]
  likes                 PostLike[]
  media                 PostMedia[]
  shares                PostShare[]
  views                 PostView[]

  @@index([authorId, createdAt])
  @@index([privacy, status, createdAt])
  @@index([category, type, createdAt])
}

model PostMedia {
  id       Int   @id @default(autoincrement())
  postId   Int
  mediaId  Int
  position Int   @default(0)
  media    Media @relation("PostMediaAsset", fields: [mediaId], references: [id], onDelete: Cascade)
  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId, position])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("PostLikedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostBookmark {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("PostBookmarkedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostView {
  id           Int      @id @default(autoincrement())
  postId       Int
  viewerUserId Int
  createdAt    DateTime @default(now())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer       User     @relation("PostViewedBy", fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerUserId])
  @@index([viewerUserId, createdAt])
}

model PostShare {
  id          Int      @id @default(autoincrement())
  postId      Int
  actorUserId Int
  createdAt   DateTime @default(now())
  actor       User     @relation("PostSharedBy", fields: [actorUserId], references: [id], onDelete: Cascade)
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostComment {
  id                Int               @id @default(autoincrement())
  postId            Int
  authorId          Int
  parentId          Int?
  text              String
  isEdited          Boolean           @default(false)
  attachmentMediaId Int?
  status            CommentStatus     @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attachmentMedia   Media?            @relation("CommentAttachment", fields: [attachmentMediaId], references: [id])
  author            User              @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent            PostComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           PostComment[]     @relation("CommentReplies")
  post              Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes             PostCommentLike[]

  @@index([postId, parentId, createdAt])
  @@index([authorId, createdAt])
}

model PostCommentLike {
  id        Int         @id @default(autoincrement())
  commentId Int
  userId    Int
  createdAt DateTime    @default(now())
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation("CommentLikedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model UserProfileLike {
  id            Int      @id @default(autoincrement())
  targetUserId  Int
  likedByUserId Int
  createdAt     DateTime @default(now())
  likedByUser   User     @relation("ProfileLikeActor", fields: [likedByUserId], references: [id], onDelete: Cascade)
  targetUser    User     @relation("ProfileLikeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([targetUserId, likedByUserId])
  @@index([likedByUserId, createdAt])
}

model UserBlock {
  id            Int      @id @default(autoincrement())
  blockerId     Int
  blockedUserId Int
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("UserBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blocker       User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId, createdAt])
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  fromUser   User                @relation("FriendRequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User                @relation("FriendRequestRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, toUserId, status])
  @@index([toUserId, status])
}

model Country {
  id               Int               @id @default(autoincrement())
  iso2             String            @unique @db.VarChar(2)
  iso3             String?           @db.VarChar(3)
  name             String
  nameBn           String?
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  adoptionListings AdoptionListing[]

  @@index([isActive, sortOrder])
  @@map("countries")
}

model BdDivision {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  nameEn           String
  nameBn           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  adoptionListings AdoptionListing[]
  districts        BdDistrict[]

  @@index([isActive, sortOrder])
  @@map("bd_divisions")
}

model BdDistrict {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  nameEn           String
  nameBn           String?
  divisionId       Int
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  adoptionListings AdoptionListing[]
  areas            BdArea[]          @relation("BdDistrictAreas")
  division         BdDivision        @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  upazilas         BdUpazila[]

  @@index([divisionId, isActive, sortOrder])
  @@map("bd_districts")
}

model BdUpazila {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  nameEn           String
  nameBn           String?
  districtId       Int
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  adoptionListings AdoptionListing[]
  areas            BdArea[]
  unions           BdUnion[]
  district         BdDistrict        @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId, isActive, sortOrder])
  @@map("bd_upazilas")
}

model BdUnion {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  nameEn    String
  nameBn    String?
  upazilaId Int
  latitude  Decimal?  @db.Decimal(10, 8)
  longitude Decimal?  @db.Decimal(11, 8)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  areas     BdArea[]
  upazila   BdUpazila @relation(fields: [upazilaId], references: [id], onDelete: Cascade)

  @@index([upazilaId, isActive, sortOrder])
  @@map("bd_unions")
}

model BdArea {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  nameEn           String
  nameBn           String?
  type             String
  reviewStatus     String            @default("CURRENT_VERIFIED")
  currentValidity  String            @default("CURRENT_VERIFIED")
  provenance       Json?
  unionId          Int?
  upazilaId        Int?
  districtId       Int?
  parentId         Int?
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  adoptionListings AdoptionListing[]
  district         BdDistrict?       @relation("BdDistrictAreas", fields: [districtId], references: [id])
  parent           BdArea?           @relation("BdAreaHierarchy", fields: [parentId], references: [id])
  children         BdArea[]          @relation("BdAreaHierarchy")
  union            BdUnion?          @relation(fields: [unionId], references: [id])
  upazila          BdUpazila?        @relation(fields: [upazilaId], references: [id])

  @@index([unionId, isActive, sortOrder])
  @@index([upazilaId, isActive, sortOrder])
  @@index([districtId, isActive, sortOrder])
  @@index([parentId, isActive, sortOrder])
  @@index([type, isActive])
  @@map("bd_areas")
}

model AnimalCategory {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  nameBn       String?
  animalTypes  AnimalType[]

  @@map("animal_categories")
}

model AnimalType {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  categoryId       Int?
  code             String?           @unique
  scientificName   String?           @db.VarChar(128)
  icon             String?           @db.VarChar(64)
  displayOrder     Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  nameBn           String?
  adoptionListings AdoptionListing[]
  category         AnimalCategory?   @relation(fields: [categoryId], references: [id])
  breeds           Breed[]

  @@index([categoryId, isActive, displayOrder])
  @@map("animal_types")
}

model AnimalSize {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  minWeightKg  Float?
  maxWeightKg  Float?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  breeds       Breed[]

  @@map("animal_sizes")
}

model AnimalColor {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  hexPreview   String?  @db.VarChar(16)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("animal_colors")
}

model CoatPattern {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("coat_patterns")
}

model Breed {
  id               Int               @id @default(autoincrement())
  name             String
  animalTypeId     Int
  code             String?           @db.VarChar(64)
  aliasNames       Json?
  originCountry    String?           @db.VarChar(64)
  defaultSizeId    Int?
  isMixed          Boolean           @default(false)
  isOther          Boolean           @default(false)
  displayOrder     Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  nameBn           String?
  isLocal          Boolean           @default(false)
  isUnknown        Boolean           @default(false)
  adoptionListings AdoptionListing[]
  animalType       AnimalType        @relation(fields: [animalTypeId], references: [id], onDelete: Cascade)
  defaultSize      AnimalSize?       @relation(fields: [defaultSizeId], references: [id])

  @@unique([name, animalTypeId])
  @@index([animalTypeId, isActive, displayOrder])
  @@index([defaultSizeId])
  @@map("breeds")
}

model AdoptionListing {
  id                           Int                   @id @default(autoincrement())
  ownerUserId                  Int
  status                       AdoptionStatus        @default(DRAFT)
  petName                      String?
  animalTypeId                 Int?
  breedId                      Int?
  sex                          String?               @db.VarChar(16)
  ageText                      String?
  ageYears                     Int?
  ageMonths                    Int?
  ageDays                      Int?
  totalAgeDays                 Int?
  approximateDateOfBirth       DateTime?
  size                         String?               @db.VarChar(64)
  colors                       String?
  story                        String?
  adoptionReason               String?
  vaccinated                   Boolean               @default(false)
  dewormed                     Boolean               @default(false)
  neutered                     Boolean               @default(false)
  microchipped                 Boolean               @default(false)
  healthInfo                   String?
  countryId                    Int?
  bdDivisionId                 Int?
  bdDistrictId                 Int?
  bdAddressMode                String?
  bdCityCorporationId          Int?
  bdZoneId                     Int?
  bdWardId                     Int?
  bdUpazilaId                  Int?
  bdUnionId                    Int?
  bdAreaId                     Int?
  ownerCityAreaText            String?
  latitude                     Decimal?              @db.Decimal(10, 8)
  longitude                    Decimal?              @db.Decimal(11, 8)
  ownerContactPhone            String?
  ownerWhatsappPhone           String?
  pickupLocationNotes          String?
  serviceAreaType              String?
  serviceAreaNotes             String?
  customServiceAreas           Json?
  allowInternationalAdoption   Boolean               @default(false)
  adopterConditions            Json?
  adoptionExperienceRequired   Boolean               @default(false)
  homeCheckRequired            Boolean               @default(false)
  vetReferenceRequired         Boolean               @default(false)
  identityVerificationRequired Boolean               @default(false)
  landlordApprovalRequired     Boolean               @default(false)
  minimumMonthlyIncomeRange    String?
  maximumMonthlyIncomeRange    String?
  notes                        String?
  mediaIds                     Int[]
  idempotencyKey               String?               @unique
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  publishedAt                  DateTime?
  archivedAt                   DateTime?
  markedForDeletionAt          DateTime?
  deletionRetries              Int                   @default(0)
  adoptionApplications         AdoptionApplication[]
  animalType                   AnimalType?           @relation(fields: [animalTypeId], references: [id])
  bdArea                       BdArea?               @relation(fields: [bdAreaId], references: [id])
  bdDistrict                   BdDistrict?           @relation(fields: [bdDistrictId], references: [id])
  bdDivision                   BdDivision?           @relation(fields: [bdDivisionId], references: [id])
  bdUpazila                    BdUpazila?            @relation(fields: [bdUpazilaId], references: [id])
  breed                        Breed?                @relation(fields: [breedId], references: [id])
  country                      Country?              @relation(fields: [countryId], references: [id])
  ownerUser                    User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([markedForDeletionAt])
  @@index([animalTypeId, breedId])
  @@map("adoption_listings")
}

model AdoptionApplication {
  id                         Int                       @id @default(autoincrement())
  adoptionListingId          Int
  applicantUserId            Int
  ownerUserId                Int
  status                     AdoptionApplicationStatus @default(SUBMITTED)
  applicantName              String
  applicantPhone             String
  applicantWhatsappPhone     String?
  applicantLocationText      String?
  applicantCityAreaText      String?
  applicantEmail             String?
  applicantHouseholdSummary  String?
  applicantExperienceSummary String?
  applicantOtherPetsSummary  String?
  applicantIncomeRange       String?
  messageToOwner             String?
  answers                    Json?
  consentToHomeCheck         Boolean                   @default(false)
  consentToFollowUp          Boolean                   @default(false)
  ownerNotes                 String?
  rejectedReason             String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  reviewedAt                 DateTime?
  closedAt                   DateTime?
  adoptionListing            AdoptionListing           @relation(fields: [adoptionListingId], references: [id], onDelete: Cascade)
  applicantUser              User                      @relation("AdoptionApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  ownerUser                  User                      @relation("AdoptionApplicationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([adoptionListingId, applicantUserId])
  @@index([applicantUserId, createdAt])
  @@index([ownerUserId, adoptionListingId, createdAt])
  @@index([adoptionListingId, status, createdAt])
  @@map("adoption_applications")
}

/// Durable verification account for the fundraising KYC flow. Replaces the
/// previous process-memory-only `FundraisingStore` account map — one row
/// per owner (`ownerUserId` unique), holding identity/location/status data
/// that must survive restarts, deploys, and multiple API instances.
/// `mediaId`/`ownerUserId` are deliberately plain scalar columns (no Prisma
/// relation to `User`/`Media`) so this migration does not touch those
/// unrelated models — existence/ownership is still enforced at the service
/// layer exactly as it was for the in-memory store.
model FundraisingVerificationAccount {
  id                    Int                               @id @default(autoincrement())
  ownerUserId           Int                               @unique
  status                FundraisingVerificationStatus     @default(DRAFT)
  accountType           String?                           @db.VarChar(32)
  fullName              String?
  /// Encrypted at rest (AES-256-GCM, see kyc-encryption.ts) as a
  /// `v<version>:<iv>:<authTag>:<ciphertext>` envelope. Canonical plaintext
  /// is a date-only value (YYYY-MM-DD) — never a DateTime, so no UTC
  /// conversion can shift the stored calendar day. No longer fixed-width
  /// (VarChar(10)) since the envelope is much longer than the plaintext.
  dateOfBirth           String?
  /// Encrypted at rest — see kyc-encryption.ts.
  presentAddress        String?
  /// Encrypted at rest — see kyc-encryption.ts.
  permanentAddress      String?
  occupation            String?
  isInternational       Boolean                           @default(false)
  divisionId            Int?
  districtId            Int?
  upazilaId             Int?
  unionId               Int?
  areaId                Int?
  area                  String?
  countryCode           String?                           @db.VarChar(8)
  countryName           String?
  stateName             String?
  cityName              String?
  /// Encrypted at rest — see kyc-encryption.ts.
  addressLine           String?
  latitude              Decimal?                          @db.Decimal(10, 8)
  longitude             Decimal?                          @db.Decimal(11, 8)
  formattedAddress      String?
  primaryDocumentType   String?
  /// Private identity fields, encrypted at rest (AES-256-GCM envelope —
  /// see kyc-encryption.ts) — never log, never serialize into any public
  /// campaign DTO. Only the owner and an authorized reviewer/admin may read
  /// these (enforced in `fundraising-store.ts`, not only route middleware).
  nationalIdNumber      String?
  birthRegNumber        String?
  passportNumber        String?
  studentIdNumber       String?
  drivingLicenceNumber  String?
  verificationDraftJson Json?
  /// Reviewer-facing rejection note — owner/admin only, never public.
  rejectionReason       String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedByUserId      Int?
  /// Optimistic-concurrency token — every update must match the version it
  /// read and increments it; a stale write fails instead of silently
  /// clobbering a concurrent change.
  version               Int                               @default(0)
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  documents             FundraisingVerificationDocument[]

  @@index([status])
  @@index([status, submittedAt])
  @@map("fundraising_verification_accounts")
}

/// Binds an uploaded `Media` row (existing media system) to a verification
/// account as either the required PRIMARY identity document or an optional
/// SUPPORTING one. Soft-deleted via `deletedAt` so removal history is kept
/// for reviewers without a hard delete.
model FundraisingVerificationDocument {
  id           Int                                 @id @default(autoincrement())
  accountId    Int
  mediaId      Int
  title        String
  documentType FundraisingVerificationDocumentType @default(SUPPORTING)
  createdAt    DateTime                            @default(now())
  deletedAt    DateTime?
  account      FundraisingVerificationAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, deletedAt])
  @@index([mediaId])
  @@map("fundraising_verification_documents")
}

