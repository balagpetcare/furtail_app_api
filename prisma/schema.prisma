/// Durable working draft for a campaign before it is submitted for review.
/// Media bindings stay a plain scalar array here (mirrors
/// `AdoptionListing.mediaIds`) since a draft is pre-publish, ephemeral
/// working data — `FundraisingCampaignMedia` (a real join table) is used
/// once a campaign actually exists, per the task's explicit ask.
model FundraisingCampaignDraft {
  id                    Int                  @id @default(autoincrement())
  publicId              String               @unique
  ownerUserId           Int
  /// DRAFT | SUBMITTED | ARCHIVED
  status                String               @default("DRAFT")
  title                 String?
  caption               String?
  category              String?
  fundingMode           String               @default("ONE_TIME")
  currencyCode          String               @default("BDT")
  targetAmountMinor     BigInt?
  monthlyGoalMinor      BigInt?
  startsAt              DateTime?
  endsAt                DateTime?
  deadline              DateTime?
  nextReviewAt          DateTime?
  beneficiaryType       String?
  beneficiaryName       String?
  petId                 Int?
  urgency               String?
  treatmentProvider     String?
  estimatedExpenseMinor BigInt?
  spendingPlan          Json?
  locationText          String?
  countryId             Int?
  stateId               Int?
  cityId                Int?
  subDistrictId         Int?
  bdAddressMode         String?
  bdDivisionId          Int?
  bdDistrictId          Int?
  bdCityCorporationId   Int?
  bdZoneId              Int?
  bdWardId              Int?
  bdUpazilaId           Int?
  bdUnionId             Int?
  bdAreaId              Int?
  mediaIds              Int[]
  submittedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  campaign              FundraisingCampaign?

  @@index([ownerUserId, status, createdAt])
  @@map("fundraising_campaign_drafts")
}

/// A published/submitted fundraising campaign. `raisedAmountMinor`,
/// `withdrawnAmountMinor`, and `donorsCount` are maintained totals derived
/// from `FundraisingDonation` — kept on the campaign row (rather than
/// computed with an aggregate query on every read) for performance, and
/// only ever changed inside the same transaction that finalizes a
/// donation, so they never drift from the underlying donation rows.
/// `version` provides optimistic concurrency for campaign edits.
model FundraisingCampaign {
  id                         Int                         @id @default(autoincrement())
  publicId                   String                      @unique
  ownerUserId                Int
  draftId                    Int?                        @unique
  title                      String
  caption                    String?
  category                   String?
  fundingMode                String                      @default("ONE_TIME")
  currencyCode               String                      @default("BDT")
  targetAmountMinor          BigInt?
  monthlyGoalMinor           BigInt?
  raisedAmountMinor          BigInt                      @default(0)
  withdrawnAmountMinor       BigInt                      @default(0)
  donorsCount                Int                         @default(0)
  startsAt                   DateTime?
  endsAt                     DateTime?
  deadline                   DateTime?
  nextReviewAt               DateTime?
  publishedAt                DateTime?
  /// DRAFT | PENDING_REVIEW | ACTIVE | PAUSED | FUNDED | COMPLETED |
  /// EXPIRED | CANCELLED | REJECTED | ARCHIVED | SUSPENDED
  status                     String
  reviewedAt                 DateTime?
  reviewedByUserId           Int?
  rejectionReason            String?
  cancelledAt                DateTime?
  archivedAt                 DateTime?
  completedAt                DateTime?
  beneficiaryType            String?
  beneficiaryName            String?
  petId                      Int?
  urgency                    String?
  treatmentProvider          String?
  estimatedExpenseMinor      BigInt?
  spendingPlan               Json?
  locationText               String?
  countryId                  Int?
  stateId                    Int?
  cityId                     Int?
  subDistrictId              Int?
  bdAddressMode              String?
  bdDivisionId               Int?
  bdDistrictId               Int?
  bdCityCorporationId        Int?
  bdZoneId                   Int?
  bdWardId                   Int?
  bdUpazilaId                Int?
  bdUnionId                  Int?
  bdAreaId                   Int?
  /// Optimistic-concurrency token — see FundraisingVerificationAccount for
  /// the same pattern (updateMany({where:{id,version}}), count 0 = conflict).
  version                    Int                         @default(0)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  draft                      FundraisingCampaignDraft?   @relation(fields: [draftId], references: [id])
  media                      FundraisingCampaignMedia[]
  donations                  FundraisingDonation[]
  fundraisingCampaignUpdates FundraisingCampaignUpdate[]

  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("fundraising_campaigns")
}

model FundraisingCampaignMedia {
  id         Int                 @id @default(autoincrement())
  campaignId Int
  mediaId    Int
  position   Int                 @default(0)
  campaign   FundraisingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, mediaId])
  @@index([campaignId, position])
  @@map("fundraising_campaign_media")
}

model FundraisingCampaignUpdate {
  id           Int                 @id @default(autoincrement())
  publicId     String              @unique
  campaignId   Int
  authorUserId Int
  title        String?
  caption      String?
  mediaIds     Int[]
  status       String              @default("PUBLISHED")
  publishedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  campaign     FundraisingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([campaignId, status, deletedAt, createdAt])
  @@map("fundraising_campaign_updates")
}

/// A single donation to a campaign. `idempotencyKey` is unique per
/// (donorUserId, campaignId, key) — a retried checkout request with the
/// same key returns the existing row instead of creating a duplicate.
model FundraisingDonation {
  id                 Int                         @id @default(autoincrement())
  publicId           String                      @unique
  referenceId        String                      @unique
  campaignId         Int
  donorUserId        Int
  /// PENDING | PROCESSING | SUCCEEDED | FAILED | CANCELLED | EXPIRED |
  /// ON_HOLD_REVIEW
  status             String
  amountMinor        BigInt
  currencyCode       String
  isAnonymous        Boolean                     @default(false)
  supportMessage     String                      @default("")
  paymentMethodLabel String                      @default("")
  consentAccepted    Boolean                     @default(true)
  idempotencyKey     String
  requestFingerprint String
  expiresAt          DateTime
  finalizedAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  campaign           FundraisingCampaign         @relation(fields: [campaignId], references: [id])
  paymentAttempts    FundraisingPaymentAttempt[]
  receipt            FundraisingReceipt?

  @@unique([donorUserId, campaignId, idempotencyKey])
  @@index([campaignId, status, createdAt])
  @@index([donorUserId, createdAt])
  @@map("fundraising_donations")
}

/// One checkout/payment attempt against a donation. `providerMetadata`
/// must only ever contain sanitized provider response fields — never raw
/// payment credentials or full provider payloads (enforced in
/// fundraising-store.ts before this is written).
model FundraisingPaymentAttempt {
  id                Int                 @id @default(autoincrement())
  attemptId         String              @unique
  donationId        Int
  provider          String
  /// Provider-side transaction reference.
  providerPaymentId String?
  redirectUrl       String?
  logId             String
  status            String
  providerMetadata  Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  donation          FundraisingDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([donationId])
  @@index([provider, providerPaymentId])
  @@map("fundraising_payment_attempts")
}

/// One row per (provider, eventId) — the unique constraint is what makes
/// webhook handling idempotent: a redelivered event finds its existing row
/// and short-circuits instead of re-applying the status transition.
model FundraisingWebhookEvent {
  id          Int       @id @default(autoincrement())
  provider    String
  eventId     String
  referenceId String
  outcome     String    @default("RECEIVED")
  /// Hash of the canonicalized payload — never the raw payload itself,
  /// which could contain provider secrets.
  payloadHash String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([referenceId])
  @@map("fundraising_webhook_events")
}

model FundraisingReceipt {
  id            Int                 @id @default(autoincrement())
  receiptNumber String              @unique
  donationId    Int                 @unique
  amountMinor   BigInt
  currencyCode  String
  issuedAt      DateTime            @default(now())
  donation      FundraisingDonation @relation(fields: [donationId], references: [id])

  @@map("fundraising_receipts")
}

/// Idempotency ledger for operations that don't otherwise have a natural
/// unique-constraint home (draft create/submit) — donation checkout uses
/// `FundraisingDonation.idempotencyKey` directly instead, since it already
/// has one row per attempt.
model FundraisingIdempotencyKey {
  id          Int      @id @default(autoincrement())
  /// e.g. "draft:create", "draft:submit"
  scope       String
  ownerUserId Int
  key         String
  /// The draft/campaign id this key resolved to.
  resourceId  Int
  createdAt   DateTime @default(now())

  @@unique([scope, ownerUserId, key])
  @@map("fundraising_idempotency_keys")
}
