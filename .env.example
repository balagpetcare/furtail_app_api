# Furtail App API environment template.
# Copy to .env for local development and fill in values as needed.
# Every variable below has a safe default in src/config/env.ts, so a
# missing .env still boots the API in development mode on port 7300.
# Never commit a real .env file or real secrets to this template.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on.
PORT=7300

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string. Leave blank for local development when no
# database is available; readiness will report NOT_CONFIGURED in that case.
DATABASE_URL=

# Central Auth verification settings for the mobile client contract.
CENTRAL_AUTH_ISSUER=http://localhost:5010
CENTRAL_AUTH_AUDIENCE=furtail-mobile
CENTRAL_AUTH_CLIENT_ID=furtail-mobile
CENTRAL_AUTH_JWKS_URI=http://localhost:5010/oauth/jwks
CENTRAL_AUTH_JWT_SECRET=replace-with-a-local-dev-only-secret
CENTRAL_AUTH_REQUIRED_CLAIMS=sub,iss,aud,exp,iat,client_id

# Comma-separated list of allowed CORS origins. Empty = no cross-origin
# requests are permitted (safe default). Example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.furtail.world
CORS_ALLOWED_ORIGINS=

# Whether cookies/credentials are allowed through CORS.
CORS_ALLOW_CREDENTIALS=true

# Request body limits for JSON and URL-encoded payloads.
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb

# Per-request processing timeout, in milliseconds, before the API returns a
# 408 Request Timeout.
REQUEST_TIMEOUT_MS=30000

# In-memory rate limiting defaults for the single-process API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Reported by GET /api/v1/version - identifies this service in logs/responses.
SERVICE_NAME=furtail-app-api

# Reported by GET /api/v1/version - application version, distinct from the
# API version (which is versioned via the URL path, e.g. /api/v1).
SERVICE_VERSION=0.1.0

# --- Fundraising KYC field-level encryption (AES-256-GCM) ---
# JSON map of key-version -> base64-encoded 32-byte AES-256 key, e.g.
#   FUNDRAISING_KYC_ENCRYPTION_KEYS={"1":"<base64 32 random bytes>"}
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required — the fundraising verification account endpoints refuse to
# read/write identity fields without this configured. Never commit a real
# key; load it from your secret manager in shared/production environments.
FUNDRAISING_KYC_ENCRYPTION_KEYS=
# Which key version new writes use. To rotate: add a new version to the
# JSON above, point this at it, deploy — old rows stay decryptable under
# their original version until re-encrypted.
FUNDRAISING_KYC_ACTIVE_KEY_VERSION=1
