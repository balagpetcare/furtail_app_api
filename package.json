{
  "name": "furtail-app-api",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal mobile-facing API for the Furtail Flutter app",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:dry-run": "tsx prisma/seed/validate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "7.9.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "helmet": "8.3.0",
    "pg": "^8.16.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "multer": "2.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/multer": "2.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "prisma": "7.9.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "overrides": {
    "babel-plugin-istanbul": "8.0.2",
    "brace-expansion": "5.0.8",
    "find-my-way": "9.7.0",
    "valibot": "1.4.2"
  }
}
